model ad_campaigns {
  id           String    @id @default(uuid())
  name         String
  objective    String?
  status       String    @default("PAUSED")
  platforms    String[]
  platform_ids Json?
  creative     Json?
  budget_daily Decimal?  @db.Decimal(12, 2)
  start_date   DateTime?
  end_date     DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@map("ad_campaigns")
