generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── PRODUCTS ──────────────────────────────────────────────────────────────────

model Product {
  id                String    @id // external store product ID (Shopify's numeric ID as a string — avoids
                                   // Postgres int4 overflow, since Shopify IDs commonly exceed 2.1 billion)
  name              String
  slug              String?
  permalink         String?
  price             String?
  regular_price     String?
  sale_price        String?
  on_sale           Boolean   @default(false)
  stock_status      String    @default("instock")
  short_description String?
  main_image_url    String?
  images            Json      @default("[]")
  categories        Json      @default("[]")
  tags              Json      @default("[]")
  attributes        Json      @default("[]")
  brand             String?
  date_modified     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  assets            Asset[]
}

model Asset {
  id          String   @id @default(cuid())
  productId   String?
  assetType   String
  width       Int
  height      Int
  templateKey String
  headline    String?
  subheadline String?
  cta         String?
  badge       String?
  fileKey     String
  mimeType    String   @default("image/png")
  variant     String   @default("A")
  platform    String   @default("meta")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  product     Product? @relation(fields: [productId], references: [id])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt
}

// ── CHAT HISTORY ──────────────────────────────────────────────────────────────

model ChatSession {
  id        String        @id @default(cuid())
  userId    String?
  userName  String?
  context   String        @default("home")  // "home" | "agent"
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId])
  @@index([createdAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String      // "user" | "assistant"
  content   String
  actions   Json?       // action buttons executed from this message
  ts        DateTime    @default(now())

  @@index([sessionId])
  @@index([ts])
}

// ── SALES ─────────────────────────────────────────────────────────────────────

model SalesContact {
  id           String          @id @default(cuid())
  email        String          @unique
  firstName    String?
  lastName     String?
  title        String?
  companyName  String?
  phone        String?
  linkedinUrl  String?
  sport        String?
  state        String?
  city         String?
  source       String          @default("manual")
  enriched     Boolean         @default(false)
  score        Int             @default(0)
  segment      String          @default("cold")
  zohoCrmId    String?
  zohoModule   String?                                  // "Leads" | "Contacts" — which module zohoCrmId actually points at
  zohoAccountId String?
  pushedToZoho Boolean         @default(false)
  status       String          @default("new")
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  accountId    String?
  account      Account?        @relation(fields: [accountId], references: [id])

  @@index([state])
  @@index([sport])
  @@index([segment])
  @@index([accountId])
}

// The account/company a contact belongs to — a school, most of the time.
// normalizedName (trimmed/lowercased/whitespace-collapsed) is the dedup key:
// contact companyName strings have no normalization of their own, so this is
// how "Lincoln High School" and "lincoln  high school" resolve to one row.
model Account {
  id             String         @id @default(cuid())
  name           String
  normalizedName String         @unique
  domain         String?
  city           String?
  state          String?
  orgType        String         @default("school")
  zohoAccountId  String?
  metadata       Json           @default("{}")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  contacts       SalesContact[]

  @@index([state])
}

// ── INBOUND QUOTE EMAIL TRACKING ─────────────────────────────────────────────
// Receives BCC'd pricing emails from any email client.
// The React app polls /api/inbound-email to consume and create deals from these.

model InboundQuote {
  id          String    @id @default(cuid())
  messageId   String?   @unique  // dedup by Message-ID header
  fromEmail   String
  fromName    String?
  toEmail     String
  toName      String?
  subject     String
  bodyText    String?   @db.Text
  receivedAt  DateTime  @default(now())
  processed   Boolean   @default(false)
  processedAt DateTime?

  @@index([processed])
}

// ── REDDIT ENGAGEMENT MODULE ──────────────────────────────────────────────────
// Approval-first workflow: ingest → evaluate → generate replies → Slack review
// → human approval → post. Posting is disabled by default (REDDIT_POSTING_ENABLED).

enum RedditThreadStatus {
  PENDING    // ingested, not yet evaluated
  EVALUATED  // fitness score computed, awaiting reply generation
  NOTIFIED   // Slack notification sent, awaiting human decision
  APPROVED   // human approved a reply variant
  REJECTED   // human rejected all variants
  POSTED     // comment successfully posted to Reddit
  SKIPPED    // filtered out by guardrails (mute, dedupe, low score)
}

model RedditThread {
  id             String              @id @default(cuid())
  redditId       String              @unique  // Reddit thing ID, e.g. t3_abc123
  subreddit      String
  title          String
  body           String              @db.Text
  url            String
  author         String
  score          Int                 @default(0)
  commentCount   Int                 @default(0)
  ingestedAt     DateTime            @default(now())
  status         RedditThreadStatus  @default(PENDING)
  evaluation     Json?               // EvaluatorResult — fitScore, reasoning, topics[], intent
  slackMessageTs String?             // Slack message timestamp (ts) for in-place updates
  slackChannelId String?             // Slack channel ID where the review card was posted
  replies        RedditReply[]

  @@index([status])
  @@index([subreddit])
  @@index([ingestedAt])
}

model RedditReply {
  id              String       @id @default(cuid())
  threadId        String
  thread          RedditThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  variant         Int          // 1 or 2
  content         String       @db.Text
  slackNotifiedAt DateTime?
  approvedBy      String?      // user identifier who approved
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  postedAt        DateTime?
  redditCommentId String?      // Reddit comment ID after posting
  upvotes         Int?         // fetched by analytics polling
  createdAt       DateTime     @default(now())

  @@index([threadId])
}

// Muted subreddits and keywords — checked during guardrail pass
model RedditMute {
  id        String   @id @default(cuid())
  type      String   // "subreddit" | "keyword"
  value     String
  createdAt DateTime @default(now())

  @@unique([type, value])
}

// One row per post action — used for rate-limit enforcement
model RedditRateLog {
  id        String   @id @default(cuid())
  action    String   // "post" | "ingest"
  createdAt DateTime @default(now())

  @@index([action, createdAt])
}

// Full audit trail of every posting attempt — persisted regardless of outcome.
// blockedBy names the gate that rejected the attempt; null means the Reddit API
// was reached (see ok + httpStatus for the result).
model RedditPostingAttempt {
  id         String   @id @default(cuid())
  replyId    String               // RedditReply.id (not a FK — preserve on reply deletion)
  threadId   String               // RedditThread.id
  attempted  Boolean  @default(false)  // true = Reddit API was called
  ok         Boolean  @default(false)  // true = Reddit accepted the comment
  httpStatus Int      @default(0)
  commentId  String?              // Reddit comment ID (t1_xyz) on success
  commentUrl String?
  blockedBy  String?              // gate: flag | not_approved | already_posted |
                                  //   one_per_thread | mute_subreddit | mute_keyword |
                                  //   daily_cap | cooldown | similarity |
                                  //   guardrail | guardrail_error | api_error
  error      String?  @db.Text
  dryRun     Boolean  @default(false)
  decidedBy  String?              // user who triggered the post
  createdAt  DateTime @default(now())

  @@index([replyId])
  @@index([threadId])
  @@index([createdAt])
}

// One row per Claude content-guardrail check — stored for every check regardless
// of outcome so approval rates and risk score trends can be computed over time.
model RedditGuardrailLog {
  id                String   @id @default(cuid())
  replyId           String               // RedditReply.id (not a FK)
  threadId          String               // RedditThread.id
  subreddit         String
  approvedForReview Boolean
  approvedForPost   Boolean
  finalRiskScore    Int
  blockReason       String?  @db.Text
  editSuggestion    String?  @db.Text
  calledFrom        String   // "check_action" | "post_gate"
  dryRun            Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([replyId])
  @@index([subreddit])
  @@index([approvedForPost])
  @@index([createdAt])
}

// ── TALK TRACK ────────────────────────────────────────────────────────────────

enum TalkTrackPhase {
  RAPPORT
  INTRO
  DISCOVERY
  PAIN
  SOLUTION
}

enum TalkTrackInputType {
  TEXT
  TEXTAREA
  SELECT
  BOOLEAN
  NUMBER
}

enum CrmModule {
  Contact
  Lead
}

enum TalkTrackSessionStatus {
  IN_PROGRESS
  COMPLETE
}

model TalkTrackQuestion {
  id            Int                @id @default(autoincrement())
  phase         TalkTrackPhase
  order         Int
  questionText  String
  helpText      String?
  inputType     TalkTrackInputType
  selectOptions Json?
  isActive      Boolean            @default(true)
  isRequired    Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([phase, order])
  @@index([phase])
}

model TalkTrackSession {
  id                       String                 @id @default(cuid())
  crmContactId             String?
  crmLeadId                String?
  crmModule                CrmModule?
  repId                    String
  schoolClass              String?
  numSports                Int?
  numAthletes              Int?
  hasOnlineStore           Boolean?
  hasBoosterClub           Boolean?
  estimatedCurrentSpend    Float?
  answers                  Json                   @default("{}")
  confirmedPains           Json                   @default("[]")
  sponsorshipGuaranteedMin Float?
  sponsorshipUpsideMax     Float?
  orgType                  String?
  sportsMode               String?
  selectedSports           Json?                  @default("[]")
  draftEmailSubject        String?
  draftEmailBody           String?                @db.Text
  status                   TalkTrackSessionStatus @default(IN_PROGRESS)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@index([repId])
  @@index([crmContactId])
  @@index([crmLeadId])
  @@index([status])
}

model SponsorshipConfig {
  id                         Int      @id
  avgOrderValuePerAthlete    Float
  avgEquipmentOrderPerSport  Float
  netMarginPct               Float
  givebackPct                Float
  schoolClassConfidence      Json
  teamStoreRevenuePerAthlete Float
  purchaseFrequencyPerYear   Float
  boosterMultiplier          Float
  lastUpdatedBy              String?
  updatedAt                  DateTime @updatedAt
}

// ── EMAIL CAMPAIGN TRACKING ───────────────────────────────────────────────────

model EmailOpen {
  id        String   @id @default(cuid())
  eid       String
  seqId     String
  contactId String
  touchStep Int      @default(0)
  openedAt  DateTime @default(now())

  @@index([seqId])
  @@index([contactId])
}

// ── AD HUB ────────────────────────────────────────────────────────────────────

model ad_attribution {
  id                   String   @id @default(uuid())
  platform             String
  platform_campaign_id String?
  platform_ad_id       String?
  zoho_deal_id         String?
  zoho_contact_id      String?
  contact_email        String?
  attributed_revenue   Decimal  @default(0) @db.Decimal(12, 2)
  attribution_type     String   @default("last_click")
  converted_at         DateTime @default(now())
  created_at           DateTime @default(now())

  @@index([platform])
  @@index([zoho_deal_id])
  @@map("ad_attribution")
}

// ── ANALYTICS ─────────────────────────────────────────────────────────────────

model utm_links {
  id           String   @id @default(uuid())
  label        String
  destination  String
  utm_source   String
  utm_medium   String
  utm_campaign String
  utm_content  String?
  utm_term     String?
  full_url     String
  clicks       Int      @default(0)
  created_by   String?
  created_at   DateTime @default(now())

  @@index([utm_campaign])
  @@map("utm_links")
}

model alert_rules {
  id           String         @id @default(uuid())
  name         String
  platform     String?
  campaign_id  String?
  metric       String
  operator     String
  threshold    Decimal        @db.Decimal(12, 4)
  enabled      Boolean        @default(true)
  notify_slack Boolean        @default(false)
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt
  history      alert_history[]

  @@index([enabled])
  @@map("alert_rules")
}

model alert_history {
  id            String      @id @default(uuid())
  rule_id       String
  platform      String
  campaign_id   String?
  campaign_name String?
  metric        String
  value         Decimal     @db.Decimal(12, 4)
  threshold     Decimal     @db.Decimal(12, 4)
  fired_at      DateTime    @default(now())
  rule          alert_rules @relation(fields: [rule_id], references: [id], onDelete: Cascade)

  @@index([rule_id])
  @@index([fired_at(sort: Desc)])
  @@map("alert_history")
}

// ── AGENT BRAIN ───────────────────────────────────────────────────────────────
// Price lists: source of truth for quoting (Edgar reads this)

model Supplier {
  id          String      @id @default(cuid())
  name        String
  category    String?
  rep         String?
  repEmail    String?
  repPhone    String?
  notes       String?     @db.Text
  lastUpdated DateTime?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items        PriceItem[]
  vendorBills  VendorBill[]

  paymentFriction   String?  @default("UNRATED")  // LOW | MEDIUM | HIGH | UNRATED
  paymentTerms      String?                        // net 30 | net 60 | net 90
  latePenaltyTerms  String?
  frictionNotes     String?  @db.Text

  @@index([name])
  @@index([active])
}

model PriceItem {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  sku        String?
  name       String
  brand      String?  // manufacturer/brand (e.g. "DeMarini", "Wilson") — distinct from
                       // supplier/distributor, since one uploaded price list can span
                       // many brands (a buying-group or distributor catalog)
  category   String?
  unit       String?  @default("each")
  cost       Decimal? @db.Decimal(12, 2)
  lastCost   Decimal? @db.Decimal(12, 2)
  map        Decimal? @db.Decimal(12, 2)
  msrp       Decimal? @db.Decimal(12, 2)
  ourPrice   Decimal? @db.Decimal(12, 2)
  gmFloorPct Float?

  marketLow      Decimal? @db.Decimal(12, 2)
  marketHigh     Decimal? @db.Decimal(12, 2)
  competitors    Json     @default("[]")
  recommendation String?
  marketNote     String?  @db.Text
  scannedAt      DateTime?

  updatedAt  DateTime @updatedAt

  @@index([supplierId])
  @@index([sku])
  @@index([category])
}

// Shared memory: the organizational brain
model AgentMemory {
  id         String   @id @default(cuid())
  scope      String   @default("org")
  entity     String?
  key        String
  value      String   @db.Text
  agentId    String
  confidence Float    @default(1.0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([scope, entity, key])
  @@index([entity])
  @@index([scope])
}

// Interaction + outcome log: the feedback loop
model AgentInteraction {
  id        String    @id @default(cuid())
  agentId   String
  userId    String?
  action    String
  entity    String?
  input     Json      @default("{}")
  output    Json      @default("{}")
  outcome   String    @default("pending")
  outcomeAt DateTime?
  blockedBy String?
  dryRun    Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([agentId])
  @@index([entity])
  @@index([outcome])
  @@index([createdAt])
}

// ── Ledger / reconciliation models ───────────────────────────────────────────

model DealInvoice {
  id            String   @id @default(cuid())
  crmDealId     String
  crmDealName   String?
  quoteRef      String?
  poNumber      String?
  zohoInvoiceId String?  @unique
  status        String   @default("DRAFT")      // DRAFT | SENT | PARTIAL | PAID | OVERDUE | VOID
  amountTotal   Decimal? @db.Decimal(12, 2)
  amountPaid    Decimal? @db.Decimal(12, 2)
  dueDate       DateTime?
  triggerSource String   @default("MANUAL")     // CRM_WEBHOOK | MANUAL
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([crmDealId])
  @@index([status])
}

model TeamStore {
  id             String   @id @default(cuid())
  name           String
  orgIdentifiers Json     @default("[]")
  zohoContactId  String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deposits       Deposit[]

  @@index([name])
}

model Deposit {
  id                  String   @id @default(cuid())
  source              String                       // STRIPE | SHOPIFY | creditcard | other
  zohoBankTxnId       String   @unique
  amount              Decimal  @db.Decimal(12, 2)
  txnDate             DateTime
  orgNameRaw          String?
  matchedInvoiceId    String?
  matchedTeamStoreId  String?
  teamStore           TeamStore? @relation(fields: [matchedTeamStoreId], references: [id])
  matchedVendorBillId String?                       // AP-side match — credit card charge → VendorBill
  matchConfidence     Float?
  status              String    @default("PENDING_REVIEW") // PENDING_REVIEW | APPROVED | DUPLICATE | REVERSED
  categorizedAs       String?                       // final label, set on approve
  suggestedAccountId  String?                       // ledger's proposed Zoho Books GL account
  suggestedLabel      String?                       // human-readable proposal, e.g. "Team Store Sales" / "Bank Rule: Shipping"
  suggestionSource    String?                       // memory | teamstore | invoice | vendorbill | rule | none
  approvedAccountId   String?                       // account actually pushed to Zoho (may differ if edited)
  approvedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@index([status])
  @@index([source])
}

model VendorBill {
  id                String   @id @default(cuid())
  supplierId        String
  supplier          Supplier @relation(fields: [supplierId], references: [id])
  vendorInvoiceNo   String?
  poNumber          String?
  zohoBillId        String?  @unique
  fileUrl           String
  status            String   @default("PENDING_REVIEW") // PENDING_REVIEW | MAPPED | CREATED | NEEDS_REVIEW
  totalAmount       Decimal? @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lineItems         VendorBillLineItem[]

  @@index([supplierId])
  @@index([status])
}

model VendorBillLineItem {
  id                 String     @id @default(cuid())
  vendorBillId       String
  vendorBill         VendorBill @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  rawDescription     String
  rawSku             String?
  quantity           Decimal    @db.Decimal(12, 2)
  unitCost           Decimal    @db.Decimal(12, 2)
  matchedPriceItemId String?
  matchConfidence    Float?
  needsReview        Boolean    @default(false)

  @@index([vendorBillId])
}

// ── ANNIE — financial analyst ─────────────────────────────────────────────────

model FinancialSnapshot {
  id              String   @id @default(cuid())
  snapshotDate     DateTime
  periodType       String                        // WEEKLY | MONTHLY
  revenueTotal     Decimal? @db.Decimal(12, 2)
  cogsTotal        Decimal? @db.Decimal(12, 2)
  grossMargin      Decimal? @db.Decimal(5, 2)
  cashPosition     Decimal? @db.Decimal(12, 2)
  arTotal          Decimal? @db.Decimal(12, 2)
  arOverdue        Decimal? @db.Decimal(12, 2)
  apTotal          Decimal? @db.Decimal(12, 2)
  pipelineValue    Decimal? @db.Decimal(12, 2)
  rawZohoPL        Json?
  rawZohoBS        Json?
  createdAt        DateTime @default(now())
  @@index([snapshotDate])
  @@index([periodType])
}

model Forecast {
  id               String   @id @default(cuid())
  forecastDate     DateTime @default(now())
  horizonMonths    Int
  method           String
  projectedRevenue Json
  projectedCash    Json
  assumptions      Json
  actualVsForecast Json?
  createdAt        DateTime @default(now())
  @@index([forecastDate])
}

model Insight {
  id             String   @id @default(cuid())
  category       String                          // OPPORTUNITY | SPEND_CUT | RISK | HEALTH_FLAG | PAYMENT_PLAN
  title          String
  detail         String   @db.Text
  supportingData Json?
  status         String   @default("NEW")         // NEW | REVIEWED | ACTED_ON | DISMISSED
  surfacedIn     String?                           // DIGEST_WEEKLY | DIGEST_MONTHLY | CHAT
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([category])
  @@index([status])
}

model DigestLog {
  id           String   @id @default(cuid())
  digestType   String                            // WEEKLY | MONTHLY
  sentAt       DateTime @default(now())
  channel      String                            // SLACK | EMAIL
  insightIds   Json
  snapshotId   String?
}

model CustomerReliability {
  id              String   @id @default(cuid())
  zohoContactId   String   @unique
  customerName    String
  reliabilityFlag String   @default("UNRATED")    // RELIABLE | INCONSISTENT | CHRONIC_LATE | UNRATED
  avgDaysLate     Float?                           // computed from paid-invoice history, not manual
  notes           String?  @db.Text
  updatedAt       DateTime @updatedAt
  @@index([reliabilityFlag])
}

// ── SMS (Twilio) ────────────────────────────────────────────────────────────

model SmsMessage {
  id        String   @id @default(cuid())
  phone     String                                // E.164, e.g. +19195551234
  direction String                                // out | in
  body      String   @db.Text
  status    String   @default("sent")             // sent | delivered | failed | received
  twilioSid String?
  createdAt DateTime @default(now())
  @@index([phone])
}

// ── BULK OUTREACH (Brad) ──────────────────────────────────────────────────────
// A durable draft of an uploaded cold-outreach sheet (see BulkOutreach.jsx) —
// survives navigation/reload so a rep can leave and come back to review the
// column mapping, edit a drafted email, or add a follow-up before approving.
// Once approved it's converted into a real Campaign (in app_state.campaigns)
// for actual sending/tracking; this row just gets tagged with that
// campaignId and left around as a record of what was uploaded and how it
// was mapped.
model OutreachBatch {
  id            String   @id @default(cuid())
  name          String
  fileName      String?
  status        String   @default("draft")        // draft | active | approved
  columnMap     Json?                              // detected field -> source header, for display/edit
  leads         Json                               // full parsed rows incl. per-lead touches[{subject,body,sentAt?}], plus bounced/bouncedAt/bounceNote once flagged
  templates     Json?                              // EMAIL STEPS drafts, keyed by position: { "step0"/"step1"/"step2": {subject,body,label} }
  totalCount    Int      @default(0)
  sendableCount Int      @default(0)
  touchCount    Int      @default(0)
  startDt       String?
  batchSize     Int      @default(25)
  touchGapDays  Int      @default(5)
  campaignId    String?                            // set once approved
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([status])
}

// ── TEAM STORE SETTLEMENT ───────────────────────────────────────────────────
// Team store orders live in the ST1 admin app (api.st1sports.com), not here —
// these tables are a local, periodically-synced cache used purely for
// reporting ("what did each school sell, what do we owe"). The admin app is
// the source of truth for order/payable data; RevOps is the source of truth
// for whether a payable has actually been PAID, since the admin app exposes
// no write endpoint for that and no payment date/reference at all. A sync
// upserts TeamStoreOrder/TeamStoreOrderLine/TeamStorePayable from the admin
// API and never touches PayablePayment — that table only ever changes when
// someone records a payment in RevOps itself. See api/_lib/teamStoreSync.js.
model TeamStoreOrder {
  id                 String   @id                   // admin app's own order id — natural key, not generated
  referenceNumber    String   @unique                // e.g. "ST1-26-00583"
  createdAt          DateTime?                       // upstream order creation date — used to bucket monthly reports
  paidAt             DateTime?
  status             String?
  storeId            String?
  storeName          String?
  isUsaStore         Boolean  @default(false)        // teamStore.isUSA — delta-share store vs. ST1-owned store
  tax                Decimal? @db.Decimal(12, 2)
  shipping           Decimal? @db.Decimal(12, 2)
  subTotal           Decimal? @db.Decimal(12, 2)
  totalAmount        Decimal? @db.Decimal(12, 2)
  itemCount          Int?
  unitCount          Int?
  usaCut             Decimal? @db.Decimal(12, 2)
  productSupplierCut Decimal? @db.Decimal(12, 2)
  teamStoreRevenue   Decimal? @db.Decimal(12, 2)
  raw                Json                            // full order detail payload, for anything not broken out above
  syncedAt           DateTime @default(now())
  lines              TeamStoreOrderLine[]
  payables           TeamStorePayable[]

  @@index([paidAt])
  @@index([createdAt])
  @@index([storeId])
}

model TeamStoreOrderLine {
  id             String   @id @default(cuid())
  orderId        String
  order          TeamStoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  externalItemId String                              // items[].id from the admin app — scoped per order, used for idempotent upserts
  sku            String?
  productName    String?
  supplierName   String?
  size           String?
  unitPrice      Decimal? @db.Decimal(12, 2)
  quantity       Int?
  amount         Decimal? @db.Decimal(12, 2)
  baseCost       Decimal? @db.Decimal(12, 2)         // LIVE catalogue data, can drift after the order shipped — margin analysis only, never a payout figure
  decorationCost Decimal? @db.Decimal(12, 2)         // resolved from /admin/decoration_cost against this line's design — same caveat as baseCost
  childStoreName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([orderId, externalItemId])
  @@index([orderId])
}

model TeamStorePayable {
  id              String   @id                       // `${referenceNumber}~${type}~${slug(label)}` — the payee's own id repeats across rows, this is the real unique key
  orderId         String
  order           TeamStoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  referenceNumber String                              // denormalized off the id for querying/display without a join
  payeeType       String                              // team_store | supplier | product_supplier
  payeeLabel      String
  payeeExternalId String?                             // payables[].id — the PAYEE's id, NOT unique per payable row
  amount          Decimal  @db.Decimal(12, 2)          // stored payable amount — the source of truth for what's owed, never recomputed from live cost data
  platformPaid    Boolean  @default(false)             // upstream payables[].paid — a flag only, no date/reference/amount behind it
  payoutMethod    String?
  payoutEnabled   Boolean? // upstream payables[].payoutEnabled — false here is a real exception (see flagExceptions), not a permission gate we control
  storeName       String?
  orderPaidAt     DateTime?
  syncedAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt
  payment         PayablePayment?

  @@index([orderId])
  @@index([payeeType])
  @@index([platformPaid])
}

// RevOps' own payment record — deliberately separate from TeamStorePayable so
// a re-sync (which only ever writes upstream-derived fields on that table)
// can never touch what was actually paid. One row per payable: the admin
// app has no payment date, reference, batch, or amount-paid anywhere, and no
// write endpoint to push a "paid" flag back to it — this is a RevOps-only
// record, and the UI must be clear that marking paid here does not sync
// upstream.
model PayablePayment {
  payableKey   String   @id                          // = TeamStorePayable.id
  payable      TeamStorePayable @relation(fields: [payableKey], references: [id])
  paidOn       DateTime
  method       String?
  reference    String?
  amountPaid   Decimal  @db.Decimal(12, 2)
  note         String?
  recordedById String?
  recordedAt   DateTime @default(now())
}

// Delta-share fee terms, effective-dated so a historical month reprices
// against the terms actually in force then rather than whatever's current —
// Matt's stated terms and what the platform actually applies have already
// been observed to diverge (3.5%+$2/item stated vs. 2.90%+$2/item applied
// in August), and that variance is itself a reportable number, not an error
// to silently correct.
model SettlementConfig {
  id            String   @id @default(cuid())
  feeRate       Decimal  @default(0.035) @db.Decimal(6, 4)
  feePerItem    Decimal  @default(2.00) @db.Decimal(12, 2)
  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  @@index([effectiveFrom])
}

model TeamStoreSyncRun {
  id               String    @id @default(cuid())
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  ordersSeen       Int       @default(0)
  payablesUpserted Int       @default(0)
  errors           Json      @default("[]")

  @@index([startedAt])
}

// Proposed matches between a real-money event (a Stripe charge/payout, or a
// bank feed's settled transaction) and a TeamStoreOrder (money in) or
// TeamStorePayable (money out). This table IS the confirmation record — it
// never mutates TeamStoreOrder/TeamStorePayable/PayablePayment itself. A
// fuzzy match is never auto-applied: every row starts PENDING_REVIEW and
// only becomes APPROVED (or REJECTED) through an explicit human action,
// which is what "store which source confirmed it" means here — sourceType +
// sourceId on an APPROVED row.
model SettlementMatch {
  id              String    @id @default(cuid())
  direction       String                                // in | out
  targetType      String                                // order | payable
  targetId        String                                // TeamStoreOrder.id or TeamStorePayable.id
  sourceType      String                                // stripe_charge | stripe_payout | bank_transaction
  sourceId        String                                // Stripe charge/payout id, or bank txn id
  sourceAmount    Decimal   @db.Decimal(12, 2)
  sourceDate      DateTime
  feeAmount       Decimal?  @db.Decimal(12, 2)           // Stripe processing fee — money-in only
  counterparty    String?                                // bank txn payee/description, when available
  matchConfidence Float
  suggestionBasis String                                 // reference | amount_date | amount_only
  status          String    @default("PENDING_REVIEW")   // PENDING_REVIEW | APPROVED | REJECTED
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([sourceType, sourceId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([status])
  @@index([direction])
}
