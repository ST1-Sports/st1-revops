  @@index([state])
  @@index([sport])
  @@index([segment])
}

model SalesDiscoverRun {
  id          String   @id @default(cuid())
  query       String
  targetIcp   Json     @default("{}")
  status      String   @default("pending")
  found       Int      @default(0)
  suggestions Json     @default("[]")
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SalesActivity {
  id        String       @id @default(cuid())
  contactId String
  type      String
  note      String?
  metadata  Json         @default("{}")
  createdAt DateTime     @default(now())
  contact   SalesContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model SalesCompany {
  id        String   @id @default(cuid())
  name      String
  domain    String?
  industry  String?
  size      String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── CAMPAIGN SUPPORTING MODELS ────────────────────────────────────────────────

model ChannelPlan {
  id         String   @id @default(cuid())
  campaignId String
  platform   String
  budget     Float?
  objective  String?
  targeting  Json     @default("{}")
  schedule   Json     @default("{}")
  createdAt  DateTime @default(now())
