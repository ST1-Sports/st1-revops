// ── ANALYTICS ─────────────────────────────────────────────────────────────────

model utm_links {
  id           String   @id @default(uuid())
  label        String
  destination  String
  utm_source   String
  utm_medium   String
  utm_campaign String
  utm_content  String?
  utm_term     String?
  full_url     String
  clicks       Int      @default(0)
  created_by   String?
  created_at   DateTime @default(now())

  @@index([utm_campaign])
  @@map("utm_links")
}

model alert_rules {
  id           String         @id @default(uuid())
  name         String
  platform     String?
  campaign_id  String?
  metric       String
  operator     String
  threshold    Decimal        @db.Decimal(12, 4)
  enabled      Boolean        @default(true)
  notify_slack Boolean        @default(false)
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt
  history      alert_history[]

  @@index([enabled])
  @@map("alert_rules")
}

model alert_history {
  id            String      @id @default(uuid())
  rule_id       String
  platform      String
  campaign_id   String?
  campaign_name String?
  metric        String
  value         Decimal     @db.Decimal(12, 4)
  threshold     Decimal     @db.Decimal(12, 4)
  fired_at      DateTime    @default(now())
  rule          alert_rules @relation(fields: [rule_id], references: [id], onDelete: Cascade)

  @@index([rule_id])
  @@index([fired_at(sort: Desc)])
  @@map("alert_history")
}

// ── ST1 KNOWLEDGE SYSTEM ─────────────────────────────────────────────────────
// Minimal additive foundation for sources, unstructured documents, future
// semantic-search chunks, and import/review job tracking.

enum KnowledgeSourceType {
  FILE
  PASTED_TEXT
  URL
  GOOGLE_DRIVE
  MANUAL
}

enum KnowledgeStatus {
  UPLOADED
  PROCESSING
  NEEDS_REVIEW
  APPROVED
  REJECTED
  FAILED
}

enum KnowledgeImportType {
  AI_INGESTION
  MANUAL_REVIEW
  RECHUNK
  URL_FETCH
  GOOGLE_DRIVE_SYNC
}

model KnowledgeSource {
  id               String              @id @default(cuid())
  title            String
  sourceType       KnowledgeSourceType
  sourceUrl        String?
  storageReference String?
  originalFilename String?
  uploadedBy       String?
  status           KnowledgeStatus     @default(UPLOADED)
  metadata         Json                @default("{}")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  processedAt      DateTime?

  documents  KnowledgeDocument[]
  importJobs KnowledgeImportJob[]
  structuredRecords KnowledgeStructuredRecord[]
  reviewEvents      KnowledgeReviewEvent[]
  productPricingRecords ProductPricing[]
  customerPricingOverrides CustomerPricingOverride[]
  programPricingAdjustments ProgramPricingAdjustment[]

  @@index([sourceType])
  @@index([status])
  @@index([uploadedBy])
  @@index([createdAt])
}

model KnowledgeDocument {
  id             String          @id @default(cuid())
  sourceId       String
  title          String
  category       String?
  content        String          @db.Text
  summary        String?         @db.Text
  status         KnowledgeStatus @default(UPLOADED)
  owner          String?
  effectiveDate  DateTime?
  expirationDate DateTime?
  metadata       Json            @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]
  structuredRecords KnowledgeStructuredRecord[]

  @@index([sourceId])
  @@index([status])
  @@index([category])
  @@index([owner])
  @@index([createdAt])
}

model KnowledgeChunk {
  id         String   @id @default(cuid())
  documentId String
  content    String   @db.Text
  chunkIndex Int
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@index([createdAt])
}

model KnowledgeImportJob {
  id              String              @id @default(cuid())
  sourceId        String
  importType      KnowledgeImportType
  status          KnowledgeStatus     @default(UPLOADED)
  proposedChanges Json                @default("{}")
  warnings        Json                @default("[]")
  errorMessage    String?             @db.Text
  createdAt       DateTime            @default(now())
  completedAt     DateTime?

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  structuredRecords KnowledgeStructuredRecord[]
  reviewEvents      KnowledgeReviewEvent[]

  @@index([sourceId])
  @@index([importType])
  @@index([status])
  @@index([createdAt])
}

model KnowledgeStructuredRecord {
  id            String   @id @default(cuid())
  sourceId      String
  documentId    String?
  importJobId   String?
  recordType    String
  action        String
  status        String   @default("APPROVED")
  sourceRow     String?
  fields        Json     @default("{}")
  existingValue Json?
  proposedValue Json?
  difference    Float?
  flags         Json     @default("[]")
  confidence    Float?
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  source    KnowledgeSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  document  KnowledgeDocument?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  importJob KnowledgeImportJob? @relation(fields: [importJobId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([documentId])
  @@index([importJobId])
  @@index([recordType])
  @@index([action])
  @@index([status])
  @@index([createdAt])
}

model KnowledgeReviewEvent {
  id               String   @id @default(cuid())
  sourceId         String
  importJobId      String?
  action           String
  userId           String?
  selectedChanges  Json?
  committedChanges Json?
  note             String?  @db.Text
  createdAt        DateTime @default(now())

  source    KnowledgeSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  importJob KnowledgeImportJob? @relation(fields: [importJobId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([importJobId])
  @@index([action])
  @@index([createdAt])
}

// ── PRICING RESOLUTION ───────────────────────────────────────────────────────
// Deterministic pricing layer for RevOps, proposals, purchasing, store builder,
// and agents. AI may propose imported rows, but application code calculates.

enum PricingAdjustmentType {
  PERCENT_DISCOUNT
  AMOUNT_DISCOUNT
  FIXED_PRICE
  REBATE
  SPONSORSHIP
  MARKUP_PERCENT
  MARKUP_AMOUNT
}

model ProductPricing {
  id              String   @id @default(cuid())
  sku             String
  styleNumber     String?
  brand           String?
  productName     String?
  productId       Int?
  msrp            Decimal? @db.Decimal(12, 2)
  map             Decimal? @db.Decimal(12, 2)
  wholesaleCost   Decimal? @db.Decimal(12, 2)
  dealerCost      Decimal? @db.Decimal(12, 2)
  st1Cost         Decimal? @db.Decimal(12, 2)
  currency        String   @default("USD")
  effectiveDate   DateTime?
  expirationDate  DateTime?
  sourceId        String?
  sourceTitle     String?
  confidence      Float?
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product Product?         @relation(fields: [productId], references: [id])
  source  KnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([sku])
  @@index([brand])
  @@index([sku, brand])
  @@index([productId])
  @@index([sourceId])
  @@index([effectiveDate])
  @@index([expirationDate])
}

model CustomerPricingOverride {
  id             String   @id @default(cuid())
  customerId     String
  customerName   String?
  sku            String
  brand          String?
  overrideCost   Decimal? @db.Decimal(12, 2)
  overrideMsrp   Decimal? @db.Decimal(12, 2)
  discountPct    Decimal? @db.Decimal(8, 4)
  adjustmentType PricingAdjustmentType @default(FIXED_PRICE)
  effectiveDate  DateTime?
  expirationDate DateTime?
  sourceId       String?
  sourceTitle    String?
  notes          String?  @db.Text
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  source KnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([sku])
  @@index([brand])
  @@index([customerId, sku, brand])
  @@index([sourceId])
  @@index([effectiveDate])
  @@index([expirationDate])
}

model ProgramPricingAdjustment {
  id             String   @id @default(cuid())
  programId      String
  programName    String?
  customerId     String?
  brand          String?
  sku            String?
  adjustmentType PricingAdjustmentType
  amount         Decimal  @db.Decimal(12, 4)
  priority       Int      @default(100)
  effectiveDate  DateTime?
  expirationDate DateTime?
  sourceId       String?
  sourceTitle    String?
  notes          String?  @db.Text
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  source KnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([programId])
  @@index([customerId])
  @@index([brand])
  @@index([sku])
  @@index([programId, sku, brand])
  @@index([sourceId])
  @@index([effectiveDate])
  @@index([expirationDate])
  @@index([priority])
}
