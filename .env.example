# ─────────────────────────────────────────────────────────────────────────────
# ST1 RevOps — Environment Variables
# Copy this file to .env.local for local dev, or add all to Vercel dashboard
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Anthropic Claude API key — powers all AI features (agent, outreach, etc.)
# Get it at: https://console.anthropic.com/settings/keys
ANTHROPIC_KEY=sk-ant-...

# ── AUTHENTICATION ─────────────────────────────────────────────────────────────
# PIN codes for each user — set these to any 4-digit value you choose.
# These are checked server-side by /api/auth and never exposed to the browser.
AUTH_PIN_MATT=
AUTH_PIN_REP2=
AUTH_PIN_REP3=

# ── ZOHO (CRM + Books + Campaigns + Social) ───────────────────────────────────
# 1. Go to api-console.zoho.com → Add Client → Server-based Application
# 2. Set redirect URI to: https://YOUR-DOMAIN.vercel.app/api/zoho-setup
# 3. Add ZOHO_CLIENT_ID + ZOHO_CLIENT_SECRET to Vercel, then redeploy
# 4. Visit https://YOUR-DOMAIN.vercel.app/api/zoho-setup to authorize
#    and get your ZOHO_REFRESH_TOKEN

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# From Zoho Books → Settings → Organization Profile → Org ID
ZOHO_ORG_ID=

# ── GMAIL (read inbox + send emails) ─────────────────────────────────────────
# 1. Go to console.cloud.google.com → Create project
# 2. Enable Gmail API (APIs & Services → Library → Gmail API)
# 3. Create OAuth 2.0 credentials (Web application type)
#    Redirect URI: https://YOUR-DOMAIN.vercel.app/api/gmail-setup
# 4. Add GMAIL_CLIENT_ID + GMAIL_CLIENT_SECRET to Vercel, then redeploy
# 5. Visit https://YOUR-DOMAIN.vercel.app/api/gmail-setup to authorize
#    and get your GMAIL_REFRESH_TOKEN

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ── AD ENGINE & COMMAND CENTER (optional — only needed for these modules) ─────

# Ideogram v2 API — AI product photography (Image Generator module)
# Get at: https://ideogram.ai/manage-api
IDEOGRAM_API_KEY=

# OpenAI API — gpt-image-1 image generation (Ad Engine generate-images endpoint)
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Perplexity API — used for web-search and enhanced research capabilities
# Get at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Baserow — no-code database backend (optional integration)
# Get at: https://baserow.io/settings → API tokens
BASEROW_API_KEY=
# Full Baserow instance URL (e.g. https://api.baserow.io or self-hosted URL)
BASEROW_URL=

# PostgreSQL database for ad campaigns, products, generated copy
# Options: Vercel Postgres (vercel.com/storage), Neon (neon.tech, free tier),
#          or Supabase (supabase.com, free tier)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── SHOPIFY (product catalog sync, orders, ledger reconciliation) ────────────
# 1. Shopify admin → Settings → Apps and sales channels → Develop apps → create an app
# 2. Configure Admin API scopes: read/write access to Products and Orders → install
# 3. Copy the Admin API access token
# Same SHOPIFY_STORE_URL/SHOPIFY_ACCESS_TOKEN pair is used by both the product catalog
# sync (Integrations tab, api/adengine/products.js) and Ledger's bank-reconciliation
# Shopify order-name lookup (api/agents/ledger/reconcile.js).
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_...
# Optional — public storefront domain, only used to build product permalinks.
# Falls back to SHOPIFY_STORE_URL if unset.
SHOPIFY_STOREFRONT_DOMAIN=
# Optional — webhook signing secret, only needed if you set up a Shopify product
# webhook pointing at /api/adengine/webhooks/shopify.
SHOPIFY_WEBHOOK_SECRET=

# ── SLACK ─────────────────────────────────────────────────────────────────────
# Used by the Reddit module to send interactive review cards with approve/skip/mute
# buttons. Also used for any other Slack notifications across the app.
#
# Setup steps:
# 1. Go to api.slack.com/apps → Create New App → From Scratch
# 2. Under "OAuth & Permissions" → Bot Token Scopes: add chat:write
# 3. Under "Interactivity & Shortcuts": enable Interactivity, set Request URL to
#    https://YOUR-DOMAIN.vercel.app/api/slack/actions
# 4. Install app to workspace → copy Bot User OAuth Token
# 5. Under "Basic Information" → App Credentials → copy Signing Secret
# 6. Invite the bot to your review channel: /invite @YourBotName

SLACK_BOT_TOKEN=xoxb-...        # Bot token (chat:write scope)
SLACK_SIGNING_SECRET=           # From App Credentials — verifies Slack action payloads
SLACK_REDDIT_REVIEW_CHANNEL=    # Channel ID where Reddit review cards are posted (e.g. C0123ABCDEF)

# ── REDDIT ENGAGEMENT MODULE (optional) ──────────────────────────────────────
# Approval-first workflow — posts NEVER go out without human review.
# REDDIT_AUTOMATION_ENABLED must be "true" to run ingestion and evaluation.
# REDDIT_POSTING_ENABLED must also be "true" to allow posting after approval.
# Both default to "false" — opt in explicitly for each subsystem.
#
# Setup steps:
# 1. Go to https://www.reddit.com/prefs/apps → Create app → Script type
# 2. Set redirect URI to: https://YOUR-DOMAIN.vercel.app/api/reddit-setup
# 3. Copy the client ID (under app name) and client secret
# 4. Run the OAuth flow to get REDDIT_REFRESH_TOKEN (for the posting account)

# ── Reddit OAuth credentials ───────────────────────────────────────────────
REDDIT_CLIENT_ID=               # App client ID from reddit.com/prefs/apps
REDDIT_CLIENT_SECRET=           # App client secret
REDDIT_REFRESH_TOKEN=           # OAuth2 refresh token — required only for posting
REDDIT_USERNAME=                # Reddit account username (required by Reddit API ToS)
REDDIT_USER_AGENT=              # e.g. "ST1RevOps/1.0 by u/yourname" — required by Reddit ToS

# ── Feature flags ──────────────────────────────────────────────────────────
# Master switch — enables ingestion, evaluation, and Slack notifications.
# Set to "false" to pause all Reddit activity without removing credentials.
REDDIT_AUTOMATION_ENABLED=false

# Enables posting approved replies to Reddit. Requires REDDIT_AUTOMATION_ENABLED=true.
# Even with this on, every reply still requires explicit human approval first.
REDDIT_POSTING_ENABLED=false

# When "true", all pipeline actions run in simulation mode: Claude is called,
# results are returned, but nothing is written to the DB or posted to Reddit/Slack.
# Useful for testing prompts and guardrails without side effects.
REDDIT_DRY_RUN=false

# ── Targeting ──────────────────────────────────────────────────────────────
# Comma-separated list of subreddits to monitor (no r/ prefix).
REDDIT_TARGET_SUBREDDITS=       # e.g. hockey,baseball,sportsparents

# Comma-separated brand keywords used to detect relevant threads.
# Also drives the "Mute Keyword" button label in Slack review cards.
REDDIT_BRAND_KEYWORDS=          # e.g. sports uniforms,team jerseys,ST1

# ── Rate limits and safety thresholds ─────────────────────────────────────
# Maximum number of Reddit posts allowed per calendar day (UTC).
REDDIT_DAILY_POST_LIMIT=3

# Minimum minutes that must pass between any two posts.
# Prevents burst posting if multiple approvals happen in quick succession.
REDDIT_POST_COOLDOWN_MINUTES=30

# Minimum Reddit upvote score a thread must have to be ingested and evaluated.
# Threads below this score are silently skipped during ingestion.
REDDIT_MIN_THREAD_SCORE=5

# Jaccard word-overlap threshold for similarity check at posting time (Gate 9).
# A reply scoring above this against any post from the last 14 days is blocked.
# Range: 0.0–1.0. Default 0.85 — lower = stricter deduplication.
REDDIT_MAX_SIMILARITY_THRESHOLD=0.85

# ── Static mute lists (env-level, checked before DB mute list) ─────────────
# Comma-separated subreddits to always skip, regardless of DB mute entries.
# Useful for permanent exclusions that don't need a UI to manage.
REDDIT_MUTED_SUBREDDITS=        # e.g. antiMLM,hailcorporate

# Comma-separated keywords — threads whose title or body contain any of these
# will be blocked at ingestion. Case-insensitive, checked before DB keyword mutes.
REDDIT_MUTED_KEYWORDS=          # e.g. lawsuit,recall,scam

# ── Claude model selection ─────────────────────────────────────────────────
# Override the Claude model used for each stage of the Reddit pipeline.
# Defaults to claude-sonnet-4-6 for all three if not set.
# Use a faster/cheaper model for evaluation; keep a strong model for guardrail.
ANTHROPIC_MODEL_FOR_REDDIT_EVALUATION=        # e.g. claude-haiku-4-5-20251001
ANTHROPIC_MODEL_FOR_REDDIT_REPLY_GENERATION=  # e.g. claude-sonnet-4-6
ANTHROPIC_MODEL_FOR_REDDIT_GUARDRAIL=         # e.g. claude-sonnet-4-6

# ── AD HUB — PLATFORM CONNECTIONS ────────────────────────────────────────────
# Connect each platform to enable live analytics and campaign management.
# Leave blank for platforms you're not using yet — Ad Hub handles gracefully.

# Meta (Facebook + Instagram Ads)
# 1. business.facebook.com → System Users → create system user → assign ad account
# 2. Generate a system user access token with ads_management scope
META_ACCESS_TOKEN=
# Your ad account ID (from Meta Business Manager — the number after "act_")
META_AD_ACCOUNT_ID=

# Google Ads
# 1. Apply for a developer token at: ads.google.com/aw/apiaccess
# 2. Create OAuth2 credentials in Google Cloud Console
# 3. Use the OAuth2 flow to get a refresh token with https://www.googleapis.com/auth/adwords scope
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Your Google Ads customer ID (the 10-digit number, no dashes)
GOOGLE_ADS_CUSTOMER_ID=

# LinkedIn Ads
# 1. Create an app at developer.linkedin.com
# 2. Request Marketing Developer Platform access
# 3. For long-lived tokens (RECOMMENDED — tokens last 1 year):
#    OAuth2 flow with r_ads + rw_ads + offline_access scopes
#    Set these three vars and tokens auto-refresh:
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REFRESH_TOKEN=
# 4. Legacy: short-lived static token (expires in 60 days — not recommended)
LINKEDIN_ACCESS_TOKEN=
# Your LinkedIn Sponsored Account ID (from Campaign Manager URL)
LINKEDIN_AD_ACCOUNT_ID=

# TikTok Ads
# 1. Apply at ads.tiktok.com/marketing_api/docs → get access token
# 2. Create app and get advertiser access
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# Microsoft Advertising (Bing Ads)
# 1. Register app at apps.dev.microsoft.com
# 2. OAuth2 flow with https://ads.microsoft.com/msads.manage scope
MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_CLIENT_SECRET=
MICROSOFT_ADS_REFRESH_TOKEN=
MICROSOFT_ADS_DEVELOPER_TOKEN=
MICROSOFT_ADS_CUSTOMER_ID=
MICROSOFT_ADS_ACCOUNT_ID=

# ── ZOHO WEBHOOK (attribution auto-creation) ──────────────────────────────────
# Set this to any random string, then add it as ?secret=VALUE to your Zoho webhook URL.
# Webhook URL: https://YOUR-DOMAIN.vercel.app/api/webhooks/zoho
# Trigger in Zoho CRM: Setup → Automation → Webhooks → when Deal Stage = "Closed Won"
ZOHO_WEBHOOK_SECRET=

# ── GOOGLE ANALYTICS 4 (realtime traffic widget) ─────────────────────────────
# 1. Google Cloud Console → APIs → Enable "Google Analytics Data API"
# 2. Create OAuth2 credentials (same project as Google Ads is fine)
# 3. Authorize with https://www.googleapis.com/auth/analytics.readonly scope
# 4. If you skip these, the GA4 endpoint falls back to GOOGLE_ADS_* credentials
#    and only needs GA4_PROPERTY_ID

# Your GA4 property ID (from Analytics → Admin → Property Settings)
GA4_PROPERTY_ID=

# Optional: separate OAuth credentials for GA4 (falls back to GOOGLE_ADS_* if unset)
GOOGLE_ANALYTICS_CLIENT_ID=
GOOGLE_ANALYTICS_CLIENT_SECRET=
GOOGLE_ANALYTICS_REFRESH_TOKEN=

# ── GOOGLE TAG MANAGER ────────────────────────────────────────────────────────
# 1. Google Cloud Console → APIs → Enable "Tag Manager API"
# 2. Uses same OAuth credentials as GA4 / Google Ads — no separate setup needed
# 3. GTM_ACCOUNT_ID: from tagmanager.google.com URL (accounts/{id})
# 4. GTM_CONTAINER_ID: optional — enables tag/trigger detail view

GTM_ACCOUNT_ID=
GTM_CONTAINER_ID=

# Optional: separate OAuth credentials for GTM (falls back to GOOGLE_ADS_* if unset)
GTM_CLIENT_ID=
GTM_CLIENT_SECRET=
GTM_REFRESH_TOKEN=

# ── LOCAL DEV ONLY ────────────────────────────────────────────────────────────
# Exposes key to browser for local /api/claude calls.
# Do NOT set this in Vercel production.
VITE_ANTHROPIC_KEY=sk-ant-...
