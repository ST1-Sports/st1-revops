# ─────────────────────────────────────────────────────────────────────────────
# ST1 RevOps — Environment Variables
# Copy this file to .env.local for local dev, or add all to Vercel dashboard
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Anthropic Claude API key — powers all AI features (agent, outreach, etc.)
# Get it at: https://console.anthropic.com/settings/keys
ANTHROPIC_KEY=sk-ant-...

# ── AUTHENTICATION ─────────────────────────────────────────────────────────────
# PIN codes for each user — set these to any 4-digit value you choose.
# These are checked server-side by /api/auth and never exposed to the browser.
AUTH_PIN_MATT=
AUTH_PIN_REP2=
AUTH_PIN_REP3=

# ── ZOHO (CRM + Books + Campaigns + Social) ───────────────────────────────────
# 1. Go to api-console.zoho.com → Add Client → Server-based Application
# 2. Set redirect URI to: https://YOUR-DOMAIN.vercel.app/api/zoho-setup
# 3. Add ZOHO_CLIENT_ID + ZOHO_CLIENT_SECRET to Vercel, then redeploy
# 4. Visit https://YOUR-DOMAIN.vercel.app/api/zoho-setup to authorize
#    and get your ZOHO_REFRESH_TOKEN

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# From Zoho Books → Settings → Organization Profile → Org ID
ZOHO_ORG_ID=

# ── GMAIL (read inbox + send emails) ─────────────────────────────────────────
# 1. Go to console.cloud.google.com → Create project
# 2. Enable Gmail API (APIs & Services → Library → Gmail API)
# 3. Create OAuth 2.0 credentials (Web application type)
#    Redirect URI: https://YOUR-DOMAIN.vercel.app/api/gmail-setup
# 4. Add GMAIL_CLIENT_ID + GMAIL_CLIENT_SECRET to Vercel, then redeploy
# 5. Visit https://YOUR-DOMAIN.vercel.app/api/gmail-setup to authorize
#    and get your GMAIL_REFRESH_TOKEN

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ── AD ENGINE (optional — only needed for Ad Engine module) ───────────────────

# Ideogram v2 API — AI product photography
# Get at: https://ideogram.ai/manage-api
IDEOGRAM_API_KEY=

# PostgreSQL database for ad campaigns, products, generated copy
# Options: Vercel Postgres (vercel.com/storage), Neon (neon.tech, free tier),
#          or Supabase (supabase.com, free tier)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# WooCommerce product catalog sync (optional)
WC_URL=https://yourstore.com
WC_KEY=ck_...
WC_SECRET=cs_...

# ── LOCAL DEV ONLY ────────────────────────────────────────────────────────────
# Exposes key to browser for local /api/claude calls.
# Do NOT set this in Vercel production.
VITE_ANTHROPIC_KEY=sk-ant-...
