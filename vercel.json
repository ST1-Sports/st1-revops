{
  "buildCommand": "npx prisma generate && npx prisma db push --accept-data-loss && vite build",
  "functions": {
    "api/claude.js":                              { "maxDuration": 120 },
    "api/adengine/generate-images.js":            { "maxDuration": 60 },
    "api/adengine/worker.js":                     { "maxDuration": 60 },
    "api/adengine/products.js":                   { "maxDuration": 60 },
    "api/adengine/generate-product-image.js":     { "maxDuration": 60 },
    "api/agent.js":                               { "maxDuration": 120 },
    "api/contacts/zoho-align-accounts.js":        { "maxDuration": 120 },
    "api/contacts/sync-books-accounts.js":        { "maxDuration": 120 },
    "api/contacts/area-browse.js":                { "maxDuration": 60 },
    "api/crm/rebuild-deals-from-invoices.js":     { "maxDuration": 120 },
    "api/crm/import-quote-pdf.js":                { "maxDuration": 60 },
    "api/zoho-campaigns.js":                      { "maxDuration": 30 },
    "api/zoho-social.js":                         { "maxDuration": 30 },
    "api/gmail.js":                               { "maxDuration": 30 },
    "api/sms.js":                                  { "maxDuration": 15 },
    "api/zoho.js":                                { "maxDuration": 30 },
    "api/shopify.js":                              { "maxDuration": 30 },
    "api/adengine/webhooks/shopify.js":            { "maxDuration": 30 },
    "api/reddit/index.js":                         { "maxDuration": 30 },
    "api/ads/*.js":                                { "maxDuration": 30 },
    "api/analytics/*.js":                          { "maxDuration": 30 },
    "api/crm/*.js":                                { "maxDuration": 30 },
    "api/ai/email.js":                             { "maxDuration": 30 },
    "api/perplexity.js":                           { "maxDuration": 60 },
    "api/instantly.js":                            { "maxDuration": 30 },
    "api/cron/send-batches.js":                    { "maxDuration": 300 },
    "api/cron/reddit-daily.js":                    { "maxDuration": 120 },
    "api/stripe/index.js":                         { "maxDuration": 30 },
    "api/admin-stores/index.js":                   { "maxDuration": 30 },
    "api/pricelists/*.js":                         { "maxDuration": 30 },
    "api/agents/edgar.js":                         { "maxDuration": 60 },
    "api/agents/brad.js":                          { "maxDuration": 60 },
    "api/cron/brad-inbox.js":                      { "maxDuration": 60 },
    "api/agents/ledger/reconcile.js":              { "maxDuration": 60 },
    "api/agents/ledger/invoice.js":               { "maxDuration": 60 },
    "api/agents/ledger/payments.js":             { "maxDuration": 60 },
    "api/agents/ledger/vendor-bill.js":          { "maxDuration": 90 },
    "api/agents/annie/aggregate.js":              { "maxDuration": 90 },
    "api/agents/annie/forecast.js":                { "maxDuration": 60 },
    "api/agents/annie/insights.js":                { "maxDuration": 90 },
    "api/agents/annie/ask.js":                      { "maxDuration": 60 },
    "api/agents/annie/digest.js":                  { "maxDuration": 120 },
    "api/cron/annie-digest-weekly.js":             { "maxDuration": 120 },
    "api/cron/annie-digest-monthly.js":            { "maxDuration": 120 },
    "api/cron/ledger-payments.js":               { "maxDuration": 60 },
    "api/cron/ledger-reconcile.js":               { "maxDuration": 60 },
    "api/webhooks/*.js":                           { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/cron/send-batches",       "schedule": "*/15 * * * *" },
    { "path": "/api/cron/reddit-daily",       "schedule": "0 14 * * 1-5" },
    { "path": "/api/cron/ledger-reconcile",   "schedule": "0 8 * * 1-5" },
    { "path": "/api/cron/ledger-payments",    "schedule": "0 14 * * 1-5" },
    { "path": "/api/cron/brad-inbox",         "schedule": "*/10 * * * *" },
    { "path": "/api/cron/annie-digest-weekly",  "schedule": "0 12 * * 1" },
    { "path": "/api/cron/annie-digest-monthly", "schedule": "0 13 1 * *" }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
