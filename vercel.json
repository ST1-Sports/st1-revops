{
  "buildCommand": "npx prisma generate && vite build",
  "functions": {
    "api/chat.js":                                { "maxDuration": 15 },
    "api/claude.js":                              { "maxDuration": 120 },
    "api/adengine/generate-images.js":            { "maxDuration": 60 },
    "api/adengine/worker.js":                     { "maxDuration": 60 },
    "api/adengine/products.js":                   { "maxDuration": 60 },
    "api/adengine/generate-product-image.js":     { "maxDuration": 60 },
    "api/agent.js":                               { "maxDuration": 120 },
    "api/auth.js":                                { "maxDuration": 10 },
    "api/zoho-quotes.js":                         { "maxDuration": 30 },
    "api/zoho-campaigns.js":                      { "maxDuration": 30 },
    "api/zoho-social.js":                         { "maxDuration": 30 },
    "api/gmail.js":                               { "maxDuration": 30 },
    "api/zoho.js":                                { "maxDuration": 30 },
    "api/inbound-email.js":                       { "maxDuration": 15 },
    "api/state.js":                                { "maxDuration": 15 },
    "api/reddit/index.js":                         { "maxDuration": 30 },
    "api/reddit/slack-feed.js":                    { "maxDuration": 15 },
    "api/reddit/thread-detail.js":                 { "maxDuration": 15 },
    "api/ads/meta.js":                             { "maxDuration": 30 },
    "api/ads/google.js":                           { "maxDuration": 30 },
    "api/ads/linkedin.js":                         { "maxDuration": 30 },
    "api/ads/tiktok.js":                           { "maxDuration": 30 },
    "api/ads/microsoft.js":                        { "maxDuration": 30 },
    "api/ads/youtube.js":                          { "maxDuration": 30 },
    "api/ads/status.js":                           { "maxDuration": 30 },
    "api/ads/attribution.js":                      { "maxDuration": 30 },
    "api/ads/alerts.js":                           { "maxDuration": 30 },
    "api/analytics/ga4.js":                        { "maxDuration": 30 },
    "api/analytics/gtm.js":                        { "maxDuration": 30 },
    "api/analytics/utm.js":                        { "maxDuration": 30 },
    "api/webhooks/zoho.js":                        { "maxDuration": 15 },
    "api/crm/search.js":                           { "maxDuration": 30 },
    "api/crm/lead.js":                             { "maxDuration": 30 },
    "api/crm/note.js":                             { "maxDuration": 30 },
    "api/sponsorship/calculate.js":                { "maxDuration": 15 },
    "api/sessions/index.js":                       { "maxDuration": 15 },
    "api/sessions/[id].js":                        { "maxDuration": 15 },
    "api/admin/questions.js":                      { "maxDuration": 15 },
    "api/admin/questions/reorder.js":              { "maxDuration": 15 },
    "api/admin/questions/[id].js":                 { "maxDuration": 15 },
    "api/admin/sponsorship-config.js":             { "maxDuration": 15 },
    "api/ai/email.js":                             { "maxDuration": 30 },
    "api/perplexity.js":                           { "maxDuration": 60 },
    "api/instantly.js":                            { "maxDuration": 30 },
    "api/gmail-token.js":                          { "maxDuration": 15 },
    "api/cron/send-batches.js":                    { "maxDuration": 120 }
  },
  "crons": [
    { "path": "/api/cron/send-batches", "schedule": "*/15 * * * *" }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
